{
  "paper": "Are We Really Making Much Progress? A Worrying Analysis of Recent Neural Recommendation Approaches (RecSys 2019)",
  "datasets": [
    "clothing"
  ],
  "models": [
    "ItemKNN-CFCBF"
  ],
  "split": "outer",
  "metrics": [
